---
import { portfolioData } from '../data/portfolio';

const navItems = [
  { label: 'Introduction', href: '#introduction', number: '00.' },
  { label: 'Experience', href: '#experience', number: '01.' },
  { label: 'Skills', href: '#skills', number: '02.' },
  { label: 'Projects', href: '#projects', number: '03.' },
  { label: 'Contact', href: '#contact', number: '04.' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-slate-50/80 dark:bg-slate-950/80 border-b border-slate-200 dark:border-slate-800/80 transition-colors duration-300"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Name -->
    <a
      href="#introduction"
      class="flex items-center gap-1.5 shrink-0 whitespace-nowrap group text-slate-900 dark:text-white font-bold text-base sm:text-lg tracking-tight hover:text-teal-500 dark:hover:text-teal-400 transition-colors"
    >
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-teal-500 animate-pulse shrink-0"></span>
      <span class="whitespace-nowrap">{portfolioData.name}</span>
      <span class="text-[11px] leading-none text-teal-600 dark:text-teal-400 font-normal border border-teal-500/30 px-1.5 py-0.5 rounded-full shrink-0 ml-0.5">
        dev
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2 shrink-0" aria-label="Main Navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="nav-tab px-2.5 py-1 lg:px-3.5 lg:py-1.5 rounded-lg border border-transparent text-xs lg:text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-teal-500/10 dark:hover:bg-teal-500/15 hover:border-teal-500/30 transition-all duration-200 whitespace-nowrap"
          >
            {item.number && <span class="nav-tab-number text-teal-500 text-xs mr-1 lg:mr-1.5 font-semibold transition-colors duration-200">{item.number}</span>}
            <span>{item.label}</span>
          </a>
        ))
      }

      <!-- Theme Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle Dark/Light Mode"
        class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-teal-500 dark:hover:text-teal-400 hover:border-teal-500/50 transition-colors"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          id="theme-toggle-light-icon"
          class="hidden w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          id="theme-toggle-dark-icon"
          class="hidden w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>
    </nav>

    <!-- Mobile Menu Button & Theme Toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        aria-label="Toggle Dark/Light Mode"
        class="p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-teal-500"
      >
        <svg
          id="theme-toggle-mobile-light-icon"
          class="hidden w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg
          id="theme-toggle-mobile-dark-icon"
          class="hidden w-6 h-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Animated Hamburger Button -->
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle Menu"
        aria-expanded="false"
        class="w-10 h-10 p-2 rounded-lg border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-teal-500 flex flex-col items-center justify-center gap-1.5 focus:outline-none"
      >
        <span id="hamburger-line-1" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 transform origin-center"></span>
        <span id="hamburger-line-2" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300"></span>
        <span id="hamburger-line-3" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 transform origin-center"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu with Slide & Fade Animation -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0 border-b border-transparent bg-slate-50 dark:bg-slate-950 px-4 space-y-1.5"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="mobile-nav-tab block px-3.5 py-2.5 rounded-lg border border-transparent text-base font-medium text-slate-700 dark:text-slate-300 hover:bg-teal-500/10 dark:hover:bg-teal-500/15 hover:border-teal-500/30 hover:text-teal-600 dark:hover:text-teal-400 active:bg-teal-500/25 dark:active:bg-teal-500/35 active:border-teal-500/70 active:text-teal-700 dark:active:text-teal-300 active:shadow-inner active:shadow-teal-500/20 active:scale-[0.99] transition-all duration-150"
        >
          {item.number && <span class="text-teal-500 text-xs mr-2 font-semibold">{item.number}</span>}
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  .nav-tab[data-active="true"] {
    background-color: rgba(20, 184, 166, 0.12);
    border-color: rgba(20, 184, 166, 0.4);
    color: rgb(13 148 136);
    font-weight: 600;
    box-shadow: 0 1px 4px rgba(20, 184, 166, 0.12);
  }
  :global(.dark) .nav-tab[data-active="true"] {
    background-color: rgba(20, 184, 166, 0.2);
    border-color: rgba(45, 212, 191, 0.5);
    color: rgb(45 212 191);
    box-shadow: 0 1px 8px rgba(20, 184, 166, 0.25);
  }
  .nav-tab[data-active="true"] .nav-tab-number {
    color: rgb(13 148 136);
    font-weight: 700;
  }
  :global(.dark) .nav-tab[data-active="true"] .nav-tab-number {
    color: rgb(45 212 191);
    font-weight: 700;
  }

  .mobile-nav-tab[data-active="true"] {
    background-color: rgba(20, 184, 166, 0.14);
    border-color: rgba(20, 184, 166, 0.45);
    color: rgb(13 148 136);
    font-weight: 600;
  }
  :global(.dark) .mobile-nav-tab[data-active="true"] {
    background-color: rgba(20, 184, 166, 0.22);
    border-color: rgba(45, 212, 191, 0.55);
    color: rgb(45 212 191);
  }
</style>

<script is:inline>
  const updateIcons = () => {
    const isDark = document.documentElement.classList.contains('dark');
    const lightIcons = [
      document.getElementById('theme-toggle-light-icon'),
      document.getElementById('theme-toggle-mobile-light-icon'),
    ];
    const darkIcons = [
      document.getElementById('theme-toggle-dark-icon'),
      document.getElementById('theme-toggle-mobile-dark-icon'),
    ];

    lightIcons.forEach((el) => el && el.classList.toggle('hidden', !isDark));
    darkIcons.forEach((el) => el && el.classList.toggle('hidden', isDark));
  };

  const toggleTheme = () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
  };

  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Animated mobile menu toggle
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const line1 = document.getElementById('hamburger-line-1');
  const line2 = document.getElementById('hamburger-line-2');
  const line3 = document.getElementById('hamburger-line-3');

  let isMenuOpen = false;

  const toggleMenu = (openState) => {
    isMenuOpen = typeof openState === 'boolean' ? openState : !isMenuOpen;
    menuButton?.setAttribute('aria-expanded', isMenuOpen.toString());

    if (isMenuOpen) {
      // Animate hamburger to X
      line1?.classList.add('rotate-45', 'translate-y-2');
      line2?.classList.add('opacity-0', '-translate-x-2');
      line3?.classList.add('-rotate-45', '-translate-y-2');

      // Slide open menu
      mobileMenu?.classList.remove('max-h-0', 'opacity-0', 'border-transparent');
      mobileMenu?.classList.add('max-h-96', 'opacity-100', 'pb-6', 'pt-2', 'border-slate-200', 'dark:border-slate-800');
    } else {
      // Animate X back to hamburger
      line1?.classList.remove('rotate-45', 'translate-y-2');
      line2?.classList.remove('opacity-0', '-translate-x-2');
      line3?.classList.remove('-rotate-45', '-translate-y-2');

      // Slide close menu
      mobileMenu?.classList.add('max-h-0', 'opacity-0', 'border-transparent');
      mobileMenu?.classList.remove('max-h-96', 'opacity-100', 'pb-6', 'pt-2', 'border-slate-200', 'dark:border-slate-800');
    }
  };

  menuButton?.addEventListener('click', () => toggleMenu());

  // Close mobile menu when an anchor link is clicked
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  // Scroll Spy for active nav tab highlight in the hover bar
  const sectionIds = ['introduction', 'experience', 'skills', 'projects', 'contact'];
  const navTabs = document.querySelectorAll('.nav-tab, .mobile-nav-tab');

  const updateActiveTab = () => {
    const scrollY = window.scrollY;
    const windowHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;

    // 1. If at top of page, always highlight introduction
    if (scrollY < 100) {
      setActiveNavTab('introduction');
      return;
    }

    // 2. If scrolled near the very bottom of the page, highlight contact
    if (scrollY > 400 && scrollY + windowHeight >= docHeight - 50) {
      setActiveNavTab('contact');
      return;
    }

    // 3. Middle sections: find current section intersecting the viewport reading line
    const probe = Math.min(220, windowHeight * 0.35);
    let activeId = 'introduction';

    for (const id of sectionIds) {
      const el = document.getElementById(id);
      if (el) {
        const rect = el.getBoundingClientRect();
        if (rect.top <= probe && rect.bottom > probe) {
          activeId = id;
          break;
        } else if (rect.top <= probe) {
          activeId = id;
        }
      }
    }

    setActiveNavTab(activeId);
  };

  const setActiveNavTab = (id) => {
    navTabs.forEach((tab) => {
      const href = tab.getAttribute('href');
      if (href === `#${id}`) {
        tab.setAttribute('data-active', 'true');
      } else {
        tab.removeAttribute('data-active');
      }
    });
  };

  window.addEventListener('scroll', updateActiveTab, { passive: true });
  window.addEventListener('resize', updateActiveTab, { passive: true });
  window.addEventListener('load', updateActiveTab);
  updateActiveTab();

  updateIcons();
</script>
