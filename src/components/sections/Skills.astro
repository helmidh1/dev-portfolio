---
import { portfolioData } from '../../data/portfolio';
import SkillIcon from '../SkillIcon.astro';

const categories = ['Programming', 'Web & App', 'Game Dev', 'Other'] as const;

const skillsByCategory = categories.map((cat) => ({
  category: cat,
  items: portfolioData.skills.filter((s) => s.category === cat),
}));
---

<section id="skills" class="py-20 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="flex items-center gap-4 mb-12">
      <span class="text-teal-600 dark:text-teal-400 font-semibold text-lg">02.</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
        Skills & Technologies
      </h2>
      <div class="flex-grow h-px bg-slate-200 dark:bg-slate-800"></div>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        skillsByCategory.map((group) => (
          <div class="p-6 rounded-xl border border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-900/60 shadow-sm hover:border-teal-500/40 transition-colors duration-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2.5">
              {group.items.map((skill) => (
                <span class="skill-badge cursor-pointer select-none inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700/70 bg-slate-50 dark:bg-slate-800/60 text-slate-800 dark:text-slate-200 hover:border-teal-500/50 hover:text-teal-600 dark:hover:text-teal-400 hover:scale-105 shadow-sm">
                  <SkillIcon icon={skill.icon} name={skill.name} class="w-5 h-5 sm:w-6 sm:h-6 shrink-0" />
                  <span>{skill.name}</span>
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-badge {
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: all 0.1s ease-in-out;
  }
  .skill-badge[data-selected="true"] {
    border-color: rgb(20 184 166);
    background-color: rgba(20, 184, 166, 0.15);
    color: rgb(13 148 136);
    transform: scale(1.06);
    box-shadow: 0 4px 14px rgba(20, 184, 166, 0.25);
    outline-color: rgba(20, 184, 166, 0.5);
    transition: all 0.075s ease-out;
  }
  :global(.dark) .skill-badge[data-selected="true"] {
    border-color: rgb(45 212 191);
    background-color: rgba(20, 184, 166, 0.22);
    color: rgb(45 212 191);
    box-shadow: 0 4px 18px rgba(20, 184, 166, 0.4);
    outline-color: rgba(45, 212, 191, 0.5);
  }
  .skill-badge[data-dissipating="true"] {
    transition: border-color 0.5s ease-out, background-color 0.5s ease-out, color 0.5s ease-out, transform 0.25s ease-out, box-shadow 0.5s ease-out, outline-color 0.5s ease-out;
  }
</style>

<script is:inline>
  document.addEventListener('click', (e) => {
    const badges = document.querySelectorAll('.skill-badge');
    const clickedBadge = e.target.closest('.skill-badge');

    badges.forEach((badge) => {
      if (clickedBadge && badge === clickedBadge) {
        badge.removeAttribute('data-dissipating');
        badge.setAttribute('data-selected', 'true');
      } else {
        if (badge.hasAttribute('data-selected')) {
          badge.removeAttribute('data-selected');
          badge.setAttribute('data-dissipating', 'true');
          setTimeout(() => {
            badge.removeAttribute('data-dissipating');
          }, 500);
        }
      }
    });
  });
</script>
