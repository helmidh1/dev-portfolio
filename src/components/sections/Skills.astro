---
import { portfolioData } from '../../data/portfolio';

const categories = ['Programming', 'Web & App', 'Game Dev', 'Other'] as const;

const skillsByCategory = categories.map((cat) => ({
  category: cat,
  items: portfolioData.skills.filter((s) => s.category === cat),
}));
---

<section id="skills" class="py-20 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="flex items-center gap-4 mb-12">
      <span class="text-teal-600 dark:text-teal-400 font-semibold text-lg">02.</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
        Skills & Technologies
      </h2>
      <div class="flex-grow h-px bg-slate-200 dark:bg-slate-800"></div>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        skillsByCategory.map((group) => (
          <div class="p-6 rounded-xl border border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-900/60 shadow-sm hover:border-teal-500/40 transition-colors duration-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2.5">
              {group.items.map((skill) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-slate-200 dark:border-slate-700/70 bg-slate-50 dark:bg-slate-800/60 text-slate-700 dark:text-slate-300 hover:border-teal-500/50 hover:text-teal-600 dark:hover:text-teal-400 transition-colors">
                  {skill.icon === 'git' ? (
                    <img src="/assets/icons/git_icon.png" alt="Git" class="w-3.5 h-3.5 object-contain" />
                  ) : skill.icon === 'github' ? (
                    <img src="/assets/icons/github_icon.png" alt="GitHub" class="w-3.5 h-3.5 object-contain" />
                  ) : (
                    <span class="text-teal-500 text-xs">#</span>
                  )}
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
