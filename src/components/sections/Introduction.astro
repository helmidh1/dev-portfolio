---
import { portfolioData } from '../../data/portfolio';
---

<section id="introduction" class="pt-32 pb-20 md:pt-40 md:pb-28 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <!-- Availability Status Pill -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-700 dark:text-teal-300 text-xs font-medium mb-6">
      <span class="w-2 h-2 rounded-full bg-teal-500 animate-ping"></span>
      <span>{portfolioData.availabilityText}</span>
    </div>

    <!-- Sub-heading / Greeting -->
    <p class="text-teal-600 dark:text-teal-400 text-sm md:text-base font-semibold mb-2">
      Hi, my name is
    </p>

    <!-- Main Name -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
      {portfolioData.fullName}.
    </h1>

    <!-- Hero Title -->
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold text-slate-600 dark:text-slate-400 tracking-tight mb-6">
      {portfolioData.heroTitle1}
      <span class="text-teal-600 dark:text-teal-400">
        {portfolioData.heroTitleHighlight}
      </span>
      {portfolioData.heroTitle2}
    </h2>

    <!-- Subtitle / Bio -->
    <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed max-w-2xl mb-8">
      {portfolioData.heroSubtitle}
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#projects"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-teal-600 hover:bg-teal-500 text-white font-semibold text-sm transition-all duration-200 shadow-lg shadow-teal-500/20 hover:shadow-teal-500/30 hover:-translate-y-0.5"
      >
        View Projects
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-slate-300 dark:border-slate-700 hover:border-teal-500 dark:hover:border-teal-400 text-slate-800 dark:text-slate-200 hover:text-teal-600 dark:hover:text-teal-400 font-semibold text-sm transition-all duration-200 hover:-translate-y-0.5"
      >
        Contact Me
      </a>
      <a
        href={portfolioData.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-3.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white/50 dark:bg-slate-900/50 text-slate-900 dark:text-white hover:border-slate-400 dark:hover:border-slate-500 hover:scale-105 transition-all duration-200"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>
      <a
        href={portfolioData.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-3.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white/50 dark:bg-slate-900/50 text-[#0A66C2] hover:border-[#0A66C2] hover:bg-[#0A66C2]/10 hover:scale-105 transition-all duration-200"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
