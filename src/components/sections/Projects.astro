---
import { portfolioData } from '../../data/portfolio';
import SkillIcon from '../SkillIcon.astro';

const getTagStyle = (tag: string) => {
  if (tag.includes('C#')) {
    return 'bg-purple-500/10 text-purple-700 dark:text-purple-300 border-purple-500/30';
  }
  if (tag.includes('Unity')) {
    return 'bg-slate-500/10 text-slate-700 dark:text-slate-300 border-slate-500/30';
  }
  if (tag.includes('Flutter') || tag.includes('Dart')) {
    return 'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/30';
  }
  if (tag.includes('Firebase')) {
    return 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/30';
  }
  if (tag.includes('React')) {
    return 'bg-cyan-500/10 text-cyan-700 dark:text-cyan-300 border-cyan-500/30';
  }
  if (tag.includes('TypeScript')) {
    return 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30';
  }
  if (tag.includes('Python')) {
    return 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/30';
  }
  if (tag.includes('Figma')) {
    return 'bg-rose-500/10 text-rose-700 dark:text-rose-300 border-rose-500/30';
  }
  return 'bg-teal-500/10 text-teal-700 dark:text-teal-300 border-teal-500/30';
};

const getTagIcon = (tag: string): string => {
  const t = tag.toLowerCase().trim();
  if (t === 'c#') return 'csharp';
  if (t === 'c++') return 'cpp';
  return t;
};
---

<section id="projects" class="py-20 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <!-- Section Header -->
    <div class="flex items-center gap-4 mb-12">
      <span class="text-teal-600 dark:text-teal-400 font-semibold text-lg">03.</span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
        Featured Projects
      </h2>
      <div class="flex-grow h-px bg-slate-200 dark:bg-slate-800"></div>
    </div>

    <!-- Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        portfolioData.projects.map((project) => (
          <article class="project-card cursor-pointer group flex flex-col rounded-[24px] overflow-hidden border-2 border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-950 shadow-md hover:scale-[1.03] hover:border-teal-500 hover:shadow-[0_8px_24px_rgba(20,184,166,0.25)]">
            <!-- Project Image Container -->
            <div class="relative aspect-video overflow-hidden bg-slate-100 dark:bg-slate-800">
              <img
                src={project.imagePath}
                alt={`${project.title} screenshot`}
                loading="lazy"
                class="w-full h-full object-cover object-top"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent opacity-60"></div>
            </div>

            <!-- Content -->
            <div class="p-6 flex flex-col flex-grow">
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-3">
                {project.tags.map((tag) => (
                  <span class={`inline-flex items-center gap-1.5 text-[11px] font-mono font-semibold px-2.5 py-1 rounded-lg border ${getTagStyle(tag)} shadow-sm`}>
                    <SkillIcon icon={getTagIcon(tag)} name={tag} class="w-3.5 h-3.5 shrink-0" />
                    <span>{tag}</span>
                  </span>
                ))}
              </div>

              <!-- Title -->
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-teal-600 dark:group-hover:text-teal-400 transition-colors mb-2">
                {project.title}
              </h3>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6 flex-grow">
                {project.description}
              </p>

              <!-- Actions -->
              <div class="flex items-center gap-3 pt-4 border-t border-slate-100 dark:border-slate-800/80 mt-auto">
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-teal-600 hover:bg-teal-500 text-white text-xs font-bold shadow-md shadow-teal-500/20 hover:shadow-teal-500/30 hover:-translate-y-0.5 transition-all duration-200"
                  >
                    <span>Live Demo</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
                {project.codeUrl && (
                  <a
                    href={project.codeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center gap-2 px-3 py-2 rounded-xl border border-slate-300 dark:border-slate-700 hover:border-teal-500 dark:hover:border-teal-400 bg-slate-50 dark:bg-slate-900/80 text-slate-800 dark:text-slate-200 hover:text-teal-600 dark:hover:text-teal-400 text-xs font-bold hover:-translate-y-0.5 transition-all duration-200 shadow-sm"
                  >
                    <span>Code</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    outline: 2px solid transparent;
    outline-offset: 1px;
    transition: all 0.2s ease-in-out;
  }
  .project-card[data-selected="true"] {
    transform: scale(1.03);
    border-color: rgb(20 184 166);
    box-shadow: 0 12px 28px rgba(20, 184, 166, 0.35);
    outline-color: rgba(20, 184, 166, 0.5);
    transition: all 0.15s ease-out;
  }
  :global(.dark) .project-card[data-selected="true"] {
    border-color: rgb(45 212 191);
    box-shadow: 0 12px 32px rgba(20, 184, 166, 0.45);
    outline-color: rgba(45, 212, 191, 0.5);
  }
  .project-card[data-dissipating="true"] {
    transition: transform 0.5s ease-out, border-color 1s ease-out, box-shadow 1s ease-out, outline-color 1s ease-out;
  }
</style>

<script is:inline>
  document.addEventListener('click', (e) => {
    const cards = document.querySelectorAll('.project-card');
    const clickedCard = e.target.closest('.project-card');

    cards.forEach((card) => {
      if (clickedCard && card === clickedCard) {
        card.removeAttribute('data-dissipating');
        card.setAttribute('data-selected', 'true');
      } else {
        if (card.hasAttribute('data-selected')) {
          card.removeAttribute('data-selected');
          card.setAttribute('data-dissipating', 'true');
          setTimeout(() => {
            card.removeAttribute('data-dissipating');
          }, 1000);
        }
      }
    });
  });
</script>
