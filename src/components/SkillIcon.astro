---
interface Props {
  icon: string;
  name?: string;
  class?: string;
}

const { icon, name = '', class: className = 'w-6 h-6' } = Astro.props;

const iconKey = icon.toLowerCase();
const iconPath = `/assets/skills/${iconKey}.svg`;
const isMonochrome =
  iconKey === 'github' || iconKey === 'unity' || iconKey === 'nextjs' || iconKey === 'next';
---

<img
  src={iconPath}
  alt={name || icon}
  class={`${className} object-contain transition-transform duration-200 group-hover:scale-110 ${isMonochrome ? 'dark:invert dark:brightness-150' : ''}`}
  loading="lazy"
/>
